# Settings for the labs. Lab 1, step 2 copies this file:  cp tools/lq.env.example tools/lq.env
# tools/lq.env is git-ignored. It holds secrets: never commit it, never share it.
# Load it into your shell with:  set -a; . tools/lq.env; set +a
#
# Only the first three settings are active. Change LQ_NAME now. Change the other two only if you need another value.
# The lab steps append all other settings at the end of tools/lq.env. A later line wins over an earlier one.

# An AWS region where RTCE runs. See: confluent rtce region list
LQ_REGION=eu-central-1
# auto: REST first, MCP if the org has no REST access. rest or mcp: only that path.
LQ_MODE=auto
# CHANGE THIS to your initials. Every resource name contains it, for example lq-ksi-feed-orders.
# 2 to 12 lowercase letters or digits, first a letter. lq_doctor.py warns while it is changeme.
LQ_NAME=changeme

# ---------------------------------------------------------------------------------------------
# Example: the full file after Lab 2. All values below are invented. Do not remove the "#":
# the lab steps add your own values. To set a value by hand, append it without "#".
#
# Lab 1, step 2: the ID of your Confluent Cloud org.
# LQ_ORG_ID=a1b2c3d4-e5f6-4789-abcd-0123456789ab
# Lab 1, step 4a (new environment) or step 4b (existing environment).
# LQ_ENV_ID=env-abc123
# Lab 1, step 5: your Standard cluster.
# LQ_CLUSTER_ID=lkc-abc123
# Lab 1, step 6: your Flink compute pool.
# LQ_POOL_ID=lfcp-abc123
# Lab 1, step 7: a Global API key of this org. For queries, Tableflow and Flink results.
# LQ_API_KEY=ABCDEFGHIJKLMNOP
# LQ_API_SECRET=<the secret of the Global key, 64 characters>
# Lab 2, step 2: a Kafka API key of your cluster. For the CLI producer. A Global key does not work here.
# LQ_KAFKA_KEY=QRSTUVWXYZ123456
# LQ_KAFKA_SECRET=<the secret of the Kafka key, 64 characters>
# Lab 2, step 3: the value schema ID of lq_orders. For the CLI producer.
# LQ_SCHEMA_ID=100001
